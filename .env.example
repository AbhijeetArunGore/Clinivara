# Clinivara configuration template — examples only.
# Copy to .env for local development and replace every REPLACE_* value.
# NEVER commit .env or real credentials. Production secrets must come from a secret manager
# or deployment environment; do not deploy values from this example file.

CLINIVARA_APP_ENV=development
CLINIVARA_DEBUG=false

# Generate unique high-entropy values for each environment.
CLINIVARA_AUTH_SECRET_KEY=REPLACE_WITH_GENERATED_AUTH_SECRET
CLINIVARA_TOKENIZATION_SALT=REPLACE_WITH_GENERATED_TOKENIZATION_SALT

# JSON object mapping API keys to tenant IDs. Replace the example key locally.
CLINIVARA_API_KEYS={"REPLACE_WITH_GENERATED_API_KEY":"local_tenant"}
CLINIVARA_API_KEY_HEADER_NAME=X-API-Key

CLINIVARA_STORAGE_ROOT=data/storage
CLINIVARA_MAX_UPLOAD_SIZE_BYTES=26214400
CLINIVARA_MAX_PDF_PAGES=50
CLINIVARA_MAX_IMAGE_DIMENSION_PIXELS=8000
CLINIVARA_MAX_IMAGE_PIXELS=50000000

CLINIVARA_OCR_ENABLED=true
CLINIVARA_OCR_DEFAULT_LANGUAGE=eng
CLINIVARA_OCR_FALLBACK_CHAR_THRESHOLD=50
CLINIVARA_OCR_DPI=300
CLINIVARA_OCR_TIMEOUT_SECONDS=30

CLINIVARA_DEID_POLICY_VERSION=1.0
CLINIVARA_DEID_CONFIDENCE_THRESHOLD=0.60
CLINIVARA_DATE_POLICY=redact
CLINIVARA_ENABLE_LONGITUDINAL_TOKENS=false

CLINIVARA_AUDIT_LOG_PATH=data/audit/audit_events.jsonl
CLINIVARA_LOG_LEVEL=INFO
