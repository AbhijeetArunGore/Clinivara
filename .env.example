# =====================================================================
# Clinivara Clinical Document Processing Backend Configuration
# =====================================================================
# Secure defaults template. Copy to .env and adjust values for your environment.
# NEVER commit real production secrets or API keys.

# Environment: development | testing | staging | production
CLINIVARA_APP_ENV=development
CLINIVARA_DEBUG=false

# Authentication & Secret Key
# In production, must be at least 32 characters generated via high-entropy RNG
CLINIVARA_AUTH_SECRET_KEY=change_this_to_a_secure_32_byte_secret_in_prod
CLINIVARA_API_KEY_HEADER_NAME=X-API-Key

# Storage & Trust Boundary Roots
CLINIVARA_STORAGE_ROOT=data/storage
CLINIVARA_MAX_UPLOAD_SIZE_BYTES=26214400 # 25 MB
CLINIVARA_MAX_PDF_PAGES=50
CLINIVARA_MAX_IMAGE_DIMENSION_PIXELS=8000
CLINIVARA_MAX_IMAGE_PIXELS=50000000

# OCR Settings
CLINIVARA_OCR_ENABLED=true
CLINIVARA_OCR_DEFAULT_LANGUAGE=eng
CLINIVARA_OCR_FALLBACK_CHAR_THRESHOLD=50
CLINIVARA_OCR_DPI=300
CLINIVARA_OCR_TIMEOUT_SECONDS=30

# De-identification & Privacy Policy
CLINIVARA_DEID_POLICY_VERSION=1.0
CLINIVARA_DEID_CONFIDENCE_THRESHOLD=0.60
CLINIVARA_DATE_POLICY=redact # redact | generalize_year | shift
CLINIVARA_ENABLE_LONGITUDINAL_TOKENS=false
CLINIVARA_TOKENIZATION_SALT=replace_with_high_entropy_salt_in_production

# Audit & Logging
CLINIVARA_AUDIT_LOG_PATH=data/audit/audit_events.jsonl
CLINIVARA_LOG_LEVEL=INFO
